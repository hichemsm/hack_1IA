# Copier vers interface/.env.local (app) et bridge/contracts/.env (déploiement)
# TESTNET UNIQUEMENT : n'utilisez jamais une clé qui détient de vrais fonds.

AEVUM_RPC_URL=https://rpc-test.qday.info
TUSD8_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
CAREVAULT_ADDRESS=

# Aidante (déploie et configure le coffre)
GUARDIAN_PRIVATE_KEY=

# Agent transaction : seule clé capable d'appeler agentPay
TX_AGENT_PRIVATE_KEY=
TX_AGENT_ADDRESS=

# Agent sécurité : signe les accords EIP-712, n'envoie jamais de transaction
SECURITY_PRIVATE_KEY=
SECURITY_SIGNER_ADDRESS=

# Délai avant qu'un nouveau soignant soit payable (secondes). 172800 = 48 h
PROVIDER_DELAY=172800
# Adresse qui reçoit les paiements des soignants de démo (par défaut : l'aidante, pour recycler les tUSD8)
# DEMO_PAYOUT=0x...   (laisser commenté plutôt que vide)

# LLM (optionnel : sans clé, l'agent tourne en mode hors ligne, sans lecture de PDF)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

NEXT_PUBLIC_EXPLORER_URL=https://explorer-test.qday.info
